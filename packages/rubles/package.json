{
  "name": "@vicimpa/rubles",
  "version": "0.2.0",
  "description": "Форматирование денежных сумм в рублях и копейках и перевод чисел в слова на русском языке",
  "repository": "github:vicimpa/vicimpa-library",
  "funding": "https://boosty.to/vic_dev",
  "homepage": "https://github.com/vicimpa/vicimpa-library/tree/main/packages/rubles",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "rollup -c",
    "postinstall": "[ -d ./src ] && npm run build || exit 0",
    "prepack": "yarn test && yarn typecheck && yarn build"
  },
  "type": "module",
  "keywords": [
    "ruble",
    "rubles",
    "rub",
    "rur",
    "kopeck",
    "kopecks",
    "currency",
    "money",
    "amount",
    "numeral",
    "number-to-words",
    "numbers-in-words",
    "russian",
    "сумма прописью",
    "стоимость прописью",
    "числа прописью",
    "рубли",
    "копейки",
    "документооборот",
    "javascript",
    "typescript"
  ],
  "authors": [
    "Alexey Simonenko <alexey@simonenko.su>",
    {
      "name": "PromiSe####",
      "url": "https://github.com/vicimpa",
      "email": "vicimpa@ya.ru"
    }
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "license": "MIT"
}
